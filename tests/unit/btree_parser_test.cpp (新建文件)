#include <gtest/gtest.h>
#include "dbrecovery/innodb/btree.hpp"
#include "dbrecovery/innodb/page_defs.hpp"

// 使用命名空间别名以简化代码
namespace innodb = dbrecovery::innodb;

// ==================== 辅助函数：小端序写入（用于测试）====================
template<typename T>
void write_le(uint8_t* ptr, size_t offset, T value) {
    for (size_t i = 0; i < sizeof(T); ++i) {
        ptr[offset + i] = static_cast<uint8_t>((value >> (i * 8)) & 0xFF);
    }
}

// ==================== 测试用例：BPlusTreeParser 基础功能 ====================
TEST(BPlusTreeParserTest, ParseValidLeafPage) {
    // 创建一个最小的 16KB 页
    std::vector<uint8_t> page(16384, 0);

    // --- 1. 填充 FIL Header (偏移 0-37) ---
    // Page Type: FIL_PAGE_INDEX = 9969 (偏移 38+12=50)
    write_le<uint16_t>(page.data(), 50, innodb::FIL_PAGE_INDEX);
    // LSN (偏移 38+8=46), 简化为 0
    write_le<uint64_t>(page.data(), 38 + 8, 0);
    // Page Number (偏移 38+4=42), 简化为 0
    write_le<uint32_t>(page.data(), 38 + 4, 0);

    // --- 2. 填充 B+Tree Header (偏移 38-53) ---
    // PAGE_LEVEL = 0 (叶子节点) (偏移 38+4=42)
    write_le<uint16_t>(page.data(), 38 + 4, 0);
    // PAGE_N_DIR_SLOTS = 2 (INFIMUM + SUPREMUM) (偏移 38+0=38)
    write_le<uint16_t>(page.data(), 38, 2);

    // --- 3. 填充 INFIMUM 记录 (固定偏移 54) ---
    uint16_t infimum_offset = 54;
    page[infimum_offset] = innodb::REC_INFO_MIN_REC_FLAG | innodb::REC_STATUS_INFIMUM; // info_bits
    write_le<uint16_t>(page.data(), infimum_offset + 1, 98); // next_record_offset -> SUPREMUM

    // --- 4. 填充 SUPREMUM 记录 (偏移 98) ---
    uint16_t supremum_offset = 98;
    page[supremum_offset] = innodb::REC_STATUS_SUPREMUM; // info_bits
    write_le<uint16_t>(page.data(), supremum_offset + 1, 0xFFFF); // next_record_offset -> end

    // --- 5. 填充页目录槽 (在页末尾) ---
    uint16_t dir_start = page.size() - 4; // 2 slots * 2 bytes each
    write_le<uint16_t>(page.data(), dir_start, infimum_offset);
    write_le<uint16_t>(page.data(), dir_start + 2, supremum_offset);

    // --- 6. 执行解析 ---
    innodb::BPlusTreeParser parser(page);
    bool result = parser.parse();

    // --- 7. 断言结果 ---
    EXPECT_TRUE(result) << "Parsing a valid leaf page should succeed.";
    EXPECT_EQ(parser.node_type(), innodb::BTreeNodeType::LEAF);
    EXPECT_EQ(parser.n_records(), 2); // INFIMUM + SUPREMUM
}

TEST(BPlusTreeParserTest, ParseInvalidPageType) {
    std::vector<uint8_t> page(16384, 0);

    // 设置一个无效的页类型 (FIL_PAGE_TYPE_ALLOCATED = 0)
    write_le<uint16_t>(page.data(), 50, innodb::FIL_PAGE_TYPE_ALLOCATED);

    innodb::BPlusTreeParser parser(page);
    bool result = parser.parse();

    EXPECT_FALSE(result) << "Parsing a page with invalid type should fail.";
}

TEST(BPlusTreeParserTest, CheckHealth) {
    std::vector<uint8_t> page(16384, 0);

    // 填充一个有效的页（复用上面的逻辑）
    write_le<uint16_t>(page.data(), 50, innodb::FIL_PAGE_INDEX);
    write_le<uint16_t>(page.data(), 38 + 4, 0); // PAGE_LEVEL
    write_le<uint16_t>(page.data(), 38, 2);     // PAGE_N_DIR_SLOTS

    uint16_t infimum_offset = 54;
    page[infimum_offset] = innodb::REC_INFO_MIN_REC_FLAG | innodb::REC_STATUS_INFIMUM;
    write_le<uint16_t>(page.data(), infimum_offset + 1, 98);

    uint16_t supremum_offset = 98;
    page[supremum_offset] = innodb::REC_STATUS_SUPREMUM;
    write_le<uint16_t>(page.data(), supremum_offset + 1, 0xFFFF);

    uint16_t dir_start = page.size() - 4;
    write_le<uint16_t>(page.data(), dir_start, infimum_offset);
    write_le<uint16_t>(page.data(), dir_start + 2, supremum_offset);

    innodb::BPlusTreeParser parser(page);
    parser.parse();

    auto health = parser.check_health();
    EXPECT_TRUE(health.is_valid);
    EXPECT_TRUE(health.has_infimum);
    EXPECT_TRUE(health.has_supremum);
    EXPECT_EQ(health.n_records, 2);
}

// ==================== 测试用例：BPlusTreeParser 边界情况 ====================
TEST(BPlusTreeParserTest, ParsePageTooSmall) {
    std::vector<uint8_t> page(100, 0); // 太小，无法包含必要的头信息

    innodb::BPlusTreeParser parser(page);
    bool result = parser.parse();

    EXPECT_FALSE(result) << "Parsing a too-small page should fail.";
}

TEST(BPlusTreeParserTest, ParseInvalidInfimumRecord) {
    std::vector<uint8_t> page(16384, 0);

    // 填充有效的页头
    write_le<uint16_t>(page.data(), 50, innodb::FIL_PAGE_INDEX);
    write_le<uint16_t>(page.data(), 38 + 4, 0); // PAGE_LEVEL
    write_le<uint16_t>(page.data(), 38, 2);     // PAGE_N_DIR_SLOTS

    // 填充一个格式错误的 INFIMUM 记录 (缺少 REC_INFO_MIN_REC_FLAG)
    uint16_t infimum_offset = 54;
    page[infimum_offset] = innodb::REC_STATUS_INFIMUM; // 缺少 REC_INFO_MIN_REC_FLAG
    write_le<uint16_t>(page.data(), infimum_offset + 1, 98);

    uint16_t supremum_offset = 98;
    page[supremum_offset] = innodb::REC_STATUS_SUPREMUM;
    write_le<uint16_t>(page.data(), supremum_offset + 1, 0xFFFF);

    uint16_t dir_start = page.size() - 4;
    write_le<uint16_t>(page.data(), dir_start, infimum_offset);
    write_le<uint16_t>(page.data(), dir_start + 2, supremum_offset);

    innodb::BPlusTreeParser parser(page);
    bool result = parser.parse();

    EXPECT_FALSE(result) << "Parsing a page with invalid INFIMUM record should fail.";
}
