#include <gtest/gtest.h>
#include "dbrecovery/innodb/undo_log.hpp"
#include <fstream>
#include <filesystem>

namespace dbrecovery {
namespace innodb {

TEST(UndoLogParser, ParseValidRecord) {
    // Create a minimal undo log record for testing
    std::vector<uint8_t> data(30, 0);
    
    // Write transaction ID (8 bytes)
    uint64_t trx_id = 12345;
    memcpy(data.data(), &trx_id, sizeof(trx_id));
    
    // Write rollback pointer (8 bytes)
    uint64_t roll_ptr = 67890;
    memcpy(data.data() + 8, &roll_ptr, sizeof(roll_ptr));
    
    // Write type (2 bytes)
    uint16_t type = 1; // TRX_UNDO_INSERT
    memcpy(data.data() + 16, &type, sizeof(type));
    
    // Write record data
    for (int i = 0; i < 8; ++i) {
        data[18 + i] = static_cast<uint8_t>(i);
    }
    
    dbrecovery::innodb::UndoLogParser parser;
    auto record = parser.parse_record(data.data(), data.size());
    
    EXPECT_TRUE(record.has_value());
    EXPECT_EQ(record->u_trx_id, trx_id);
    EXPECT_EQ(record->u_roll_ptr, roll_ptr);
    EXPECT_EQ(record->u_type, type);
    EXPECT_EQ(record->u_data.size(), 8);
}

TEST(UndoLogParser, ParseFile) {
    // Create a temporary undo log file
    std::string tmp_path = "/tmp/test_undo.log";
    std::ofstream out(tmp_path, std::ios::binary);
    
    // Write two minimal records
    std::vector<uint8_t> record1(26, 0); // trx_id(8) + roll_ptr(8) + type(2) + data(8)
    uint64_t trx_id = 12345;
    memcpy(record1.data(), &trx_id, sizeof(trx_id));
    out.write(reinterpret_cast<char*>(record1.data()), record1.size());
    
    std::vector<uint8_t> record2(26, 0);
    memcpy(record2.data(), &trx_id, sizeof(trx_id));
    out.write(reinterpret_cast<char*>(record2.data()), record2.size());
    
    out.close();
    
    dbrecovery::innodb::UndoLogParser parser;
    auto records = parser.parse_file(tmp_path);
    
    EXPECT_EQ(records.size(), 2);
    
    std::error_code ec;
    std::filesystem::remove(tmp_path, ec);
}

} // namespace innodb
} // namespace dbrecovery

int main(int argc, char** argv) {
    ::testing::InitGoogleTest(&argc, argv);
    return RUN_ALL_TESTS();
}
