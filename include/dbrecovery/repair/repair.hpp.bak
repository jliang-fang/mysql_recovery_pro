// ✅ 修正：移除不存在的方法调用，改为直接解析 SDI JSON 获取 BLOB 信息
std::optional<DBRecovery::InnoDB::BlobPointer> Repairer::get_blob_info_from_sdi(
    const uint8_t* page,
    size_t page_size,
    std::shared_ptr<SDIManager> sdi_manager
) {
    // ✅ 增加空指针校验
    if (!sdi_manager || !page || page_size < DBRecovery::InnoDB::UNIV_PAGE_SIZE) {
        return std::nullopt;
    }

    try {
        // ✅ 从 SDI 页面解析 JSON 获取 BLOB 元数据（简化示例）
        auto schema = DBRecovery::InnoDB::SDIManager::parse_sdi_record(
            std::span<const uint8_t>(page + 99, page_size - 99)
        );
        
        // ✅ 遍历 columns 查找 BLOB 类型字段（MySQL 8.0 中 type_id=252 对应 LONGBLOB）
        for (const auto& [pos, col] : schema.columns) {
            if (col.type == DBRecovery::InnoDB::Column::Type::BLOB ||
                col.mysql_type_id == 252 || // LONGBLOB
                col.mysql_type_id == 251 || // TEXT（部分场景可能关联 BLOB）
                col.mysql_type_id == 250) { // TINYBLOB / TINYTEXT（按需扩展）
                
                // ✅ 构造 BlobPointer：从 SDI 中提取实际空间ID、页号等信息
                DBRecovery::InnoDB::BlobPointer bp;
                bp.space_id = col.space_id.value_or(1);   // fallback to default if not present
                bp.page_no  = col.page_no.value_or(100);
                bp.offset   = col.offset.value_or(0);
                bp.length   = col.length.value_or(4096);
                
                return bp;
            }
        }
    } catch (...) {
        // ✅ 记录日志（实际实现中应加入日志记录）
        // log_error("Failed to parse SDI record for BLOB info");
    }

    return std::nullopt;
}

// ✅ 正确修复校验和（写入页头）
bool Repairer::fix_checksum(uint8_t* page, size_t page_size) {
    uint32_t correct_checksum = calculate_innodb_checksum(page, page_size);
    
    // ✅ 写入校验和字段（偏移 0，大端序）
    DBRecovery::InnoDB::MachRead::write_be<uint32_t>(page, 0, correct_checksum);
    
    return validate_crc32(std::span<const uint8_t>(page, page_size));
}
