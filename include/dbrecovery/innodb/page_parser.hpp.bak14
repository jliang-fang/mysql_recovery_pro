#ifndef DBRECOVERY_INNODB_PAGE_PARSER_HPP
#define DBRECOVERY_INNODB_PAGE_PARSER_HPP

#include <cstdint>
#include <vector>
#include <string>
#include "dbrecovery/innodb/constants.hpp"

namespace dbrecovery {
namespace innodb {

struct PageHeader {
    uint16_t page_type;
    uint16_t flags;
    uint16_t page_level:12;
    uint32_t n_dir_slots:12;
};

struct Record {
    uint32_t offset;
    uint16_t len;
    std::vector<uint8_t> data;
};

class PageParser {
public:
    explicit PageParser(const uint8_t* buffer, size_t size);

    bool parse_header();
    PageHeader get_header() const;

    std::vector<Record> parse_records() const;

    const uint8_t* data() const;
    size_t size() const;

private:
    const uint8_t* buffer_;
    size_t size_;
};

} // namespace InnoDB
} // namespace DBRecovery

#endif // DBRECOVERY_INNODB_PAGE_PARSER_HPP
