#ifndef DBRECOVERY_INNODB_PAGE_PARSER_HPP
#define DBRECOVERY_INNODB_PAGE_PARSER_HPP

#include <cstdint>
#include <vector>
#include <string>
#include "dbrecovery/innodb/constants.hpp"

namespace DBRecovery {
namespace InnoDB {

struct PageHeader {
    uint16_t page_type;          // ✅ 页类型（PageType）
    uint16_t flags;         // ✅ 标志位
    uint16_t page_level:12;      // ✅ B+树高度
    uint32_t n_dir_slots:12;// ✅ 目录槽位数
};
struct Record {
    uint32_t offset;  // ✅ 记录在页中的偏移
    uint16_t len;     // ✅ 记录长度
    std::vector<uint8_t> data; // ✅ 记录数据（简化版）
};

class PageParser {
};

} // namespace innodb
} // namespace dbrecovery

#endif // DBRECOVERY_INNODB_PAGE_PARSER_HPP
