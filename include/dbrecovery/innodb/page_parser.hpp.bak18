#pragma once
#include <vector>
#include <cstdint>
#include <cstddef>

namespace dbrecovery {
namespace innodb {

struct Record {
    uint16_t offset;
};

class PageParser {
public:
    explicit PageParser(const uint8_t* buffer, size_t size);

    bool parse_header();
    
    std::vector<Record> parse_records() const;

    const uint8_t* data() const;
    size_t size() const;

private:
    const uint8_t* buffer_;
    size_t size_;
};

} // namespace innodb
} // namespace dbrecovery

#endif // DBRECOVERY_INNODB_PAGE_PARSER_HPP
