# MySQL 9.0.0 (Preview) - Enhanced Vector & Query Cache
# Target: Testing Vector(128) and enhanced JSON support
FROM mysql/mysql-server:9.0.0

ENV MYSQL_ROOT_PASSWORD=root123
ENV MYSQL_DATABASE=testdb
ENV MYSQL_CHARACTER_SET_SERVER=utf8mb4
ENV MYSQL_COLLATION_SERVER=utf8mb4_0900_ai_ci

CMD [
  "--innodb_file_per_table=1",
  "--sql-mode=NO_ENGINE_SUBSTITUTION",
  "--character-set-server=utf8mb4",
  "--collation-server=utf8mb4_0900_ai_ci",
  "--max_allowed_packet=1G",
  "--innodb_buffer_pool_size=3G",
  "--innodb_log_file_size=2G",
  "--innodb_log_buffer_size=128M",
  "--sync_binlog=0",
  "--innodb_flush_log_at_trx_commit=0",
  "--tmp_table_size=1G",
  "--max_heap_table_size=1G",
  "--binlog_format=ROW",
  "--default_authentication_plugin=mysql_caching_sha2_password"
]
