#include "dbrecovery/innodb/sdi_manager.hpp"
#include "dbrecovery/catalog/schema_defs.hpp"
#include "dbrecovery/utils/zlib_helper.hpp"
#include "dbrecovery/innodb/mach_read.hpp"
#include <nlohmann/json.hpp>
#include <stdexcept>
#include <fstream>
#include <filesystem>

namespace dbrecovery::innodb {

dbrecovery::catalog::TableSchema SDIManager::parse_sdi_record(const uint8_t* payload, size_t payload_len) {
    if (payload_len < 20) {
        throw std::runtime_error("SDI payload too small");
    }

    // Read header fields using global read_le functions
    uint32_t type = dbrecovery::innodb::read_le<uint32_t>(payload);
    uint64_t id   = dbrecovery::innodb::read_le<uint64_t>(payload + 4);
    uint32_t uncompressed_len = dbrecovery::innodb::read_le<uint32_t>(payload + 12);
    uint32_t compressed_len   = dbrecovery::innodb::read_le<uint32_t>(payload + 16);

    if (compressed_len == 0 || compressed_len > payload_len - 20) {
        throw std::runtime_error("Invalid SDI compressed length");
    }

    const uint8_t* raw_data = payload + 20;
    
    // Decompress if needed
    std::vector<uint8_t> decompressed;
    if (type == 1) { // Compressed SDI
        try {
            decompressed = Utils::ZlibHelper::decompress(raw_data, compressed_len, uncompressed_len);
        } catch (...) {
            throw std::runtime_error("Failed to decompress SDI");
        }
    } else {
        decompressed.assign(raw_data, raw_data + compressed_len);
    }

    // Parse JSON
    try {
        auto json = nlohmann::json::parse(decompressed.begin(), decompressed.end());
        
        dbrecovery::catalog::TableSchema schema;
        if (json.contains("schema")) {
            schema.table_name = json["schema"].value("name", "");
        }
        if (json.contains("table")) {
            auto table_json = json["table"];
            schema.table_name = table_json.value("name", "");
            
            if (table_json.contains("columns")) {
                for (const auto& col : table_json["columns"]) {
                    dbrecovery::catalog::ColumnInfo column_info;
                    column_info.name = col.value("name", "");
                    // Skip type field as it doesn't exist in ColumnInfo
                    schema.columns[0] = column_info; // Simplified: use default index
                }
            }
        }
        
        return schema;
    } catch (...) {
        throw std::runtime_error("Failed to parse SDI JSON");
    }
}

} // namespace dbrecovery::innodb
