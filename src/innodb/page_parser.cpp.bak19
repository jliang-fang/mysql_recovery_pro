#include "dbrecovery/innodb/page_parser.hpp"
#include "dbrecovery/innodb/mach_read.hpp"

namespace dbrecovery {
namespace innodb {

PageParser::PageParser(const uint8_t* buffer, size_t size)
    : buffer_(buffer), size_(size) {}

bool PageParser::parse_header() {
  if (!buffer_ || size_ < 38) return false;
  
  // 简化：仅读取页类型
  page_type_ = mach_read_le<uint16_t>(buffer_ + 0);
  flags_ = mach_read_le<uint16_t>(buffer_ + 24);
  page_level_ = (flags_ >> 12) & 0x0FFF;
  
  return true;
}

std::vector<Record> PageParser::parse_records() const {
  std::vector<Record> records;
  // 简化：返回空记录列表
  return records;
}

const uint8_t* PageParser::data() const {
  return buffer_;
}

size_t PageParser::size() const {
  return size_;
}

} // namespace innodb
} // namespace dbrecovery
